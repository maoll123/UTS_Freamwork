          "name": "GET All Produk",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/api/produk",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "produk"]
            }
          }
        },
