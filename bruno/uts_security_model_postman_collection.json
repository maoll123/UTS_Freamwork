            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama_produk\": \"Earbuds TWS Wireless Bass Boost\",\n  \"harga_produk\": 350000,\n  \"foto_produk\": \"https://images.unsplash.com/photo-1590658268037-6bf12165a8df?w=500&auto=format&fit=crop&q=60\",\n  \"id_kategori\": 1\n}"
