{
  "info": {
    "_postman_id": "uts-framework-security-model-2024",
    "name": "UTS Framework - Security Model Collection",
    "description": "Koleksi API untuk pengujian RESTful API Kategori, Produk, dan Security Model Client-Server Enkripsi",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Auth (JWT)",
      "item": [
        {
          "name": "Generate JWT Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin_uts\",\n  \"role\": \"client_endpoint\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/token",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "token"]
            }
          }
        },
        {
          "name": "Verify Token Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": {
              "raw": "http://localhost:5000/api/auth/verify",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "verify"]
            }
          }
        }
      ]
    },
    {
